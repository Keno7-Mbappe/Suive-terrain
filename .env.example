# Copier ce fichier en .env et renseigner les vraies valeurs (ne jamais committer .env)

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# En production (Render) : ALLOWED_HOSTS=<nom-du-service>.onrender.com
# et CSRF_TRUSTED_ORIGINS=https://<nom-du-service>.onrender.com
CSRF_TRUSTED_ORIGINS=

# Connexion Supabase Postgres (Connection string > URI, depuis Project Settings > Database)
# Laisser vide pour développer en local avec SQLite.
DATABASE_URL=postgresql://postgres:<password>@<project-ref>.supabase.co:5432/postgres

# KoboToolbox
KOBO_API_BASE_URL=https://kf.kobotoolbox.org
KOBO_API_TOKEN=
# "suivi" couvre aussi la satisfaction bénéficiaire (module optionnel de la même soumission)
KOBO_ASSET_UID_SUIVI=
KOBO_ASSET_UID_SATISFACTION_INSTITUTION=

CORS_ALLOWED_ORIGINS=
